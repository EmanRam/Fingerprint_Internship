# -------- Copy to `.env` and fill in. Do NOT commit `.env`. --------
# Everything from week1/.env.example still applies. This file adds Week 2 settings.

# ======== Provider (Task 4: all of this must be env-driven, no hardcoding) ========
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Base URL is a SETTING, not a constant. If your code hardcodes a provider URL
# anywhere (e.g. in common/utils.py), Task 4 requires moving it here.
OPENAI_BASE_URL=https://api.openai.com/v1

# ======== LangSmith ========
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=northwind-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ======== Retrieval / index (Task 4: configurable, not baked in) ========
RETRIEVER_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=80
INDEX_PATH=/data/faiss_index          # mounted volume in docker-compose

# ======== Service (Task 3) ========
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000         # what the Streamlit UI calls
SESSION_TTL_SECONDS=3600
MAX_QUESTION_CHARS=2000               # input guardrail (Task 8)

# ======== Caching (Task 6) ========
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
SEMANTIC_CACHE_ENABLED=false          # your call — argue it either way
SEMANTIC_CACHE_THRESHOLD=0.95

# ======== Resilience (Task 8) ========
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=20

# ======== Cost accounting (Task 5) ========
# Used by scripts/cost_report.py. Update to match your actual model's pricing.
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.0006

# ======== Eval gate (Task 7) ========
EVAL_DATASET_NAME=northwind-eval-v2
EVAL_DATASET_PATH=week1/capstone_internal_docs_assistant/eval_dataset.jsonl   # local file, used by scripts/
LOG_LEVEL=INFO
