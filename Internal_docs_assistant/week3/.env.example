# -------- Copy to `.env`. Everything from week1/ and week2/ .env.example still applies. --------

# ======== Corpus (Tasks 1, 3, 6) ========
CORPUS_DIR=week3/corpus
METADATA_PATH=week3/corpus/_metadata.csv
DIRECTORY_PATH=week3/corpus/_directory.csv
INDEX_PATH=/data/faiss_index_w3          # new index — do NOT overwrite the Week 2 one

# ======== Eval (Task 2) ========
EVAL_DATASET=week3/eval/eval_v3.jsonl     # your 100-example set
EVAL_SPLIT=dev                            # dev | test — test is frozen (rule 5)
JUDGE_MODEL=                              # REQUIRED this week, and must differ from the generator
EVAL_RESULTS_DIR=week3/eval/runs

# ======== Retrieval (Task 4) — every lever is a setting, so experiments are config diffs ========
RETRIEVER_K=5
CHUNK_STRATEGY=fixed                      # fixed | structure
CHUNK_SIZE=600
CHUNK_OVERLAP=80
HYBRID_BM25_WEIGHT=0.5
RERANKER_MODEL=                           # empty = no re-ranking
RERANK_TOP_N=20

# ======== Time and truth (Task 5) ========
AS_OF_DATE=2026-10-01                     # the corpus snapshot date

# ======== Budget ========
WEEK_BUDGET_USD=25
