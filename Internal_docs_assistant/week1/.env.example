# -------- Copy this file to `.env` and fill in your keys. Do NOT commit `.env`. --------

# Pick ONE primary provider (default code path uses OpenAI).
OPENAI_API_KEY=sk-...

# Optional alternative providers -------------------------------------------------
# GROQ_API_KEY=gsk_...
# HUGGINGFACEHUB_API_TOKEN=hf_...
# (Ollama needs no key — just run `ollama serve` locally.)

# Which provider the shared helpers should use: openai | groq | ollama | huggingface
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# -------- LangSmith (needed from Task 7 onward) --------
# Get a free key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=rag-internship
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
